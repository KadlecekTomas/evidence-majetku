    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "10.9.0",
    "eslint-config-next": "16.3.2",
    "prisma": "7.9.1",
